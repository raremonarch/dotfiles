[
{
    "output": "HDMI-A-1",
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 4,
    "margin-top": 0,
    "margin-left": 0,
    "margin-right": 0,
    "modules-left": [
        "custom/power",
        "custom/workspaces",
        "cpu",
        "memory"
    ],
    "modules-center": [
        "clock",
        "custom/updates"
    ],
    "modules-right": [
        "custom/layout",
        "battery",
        "wireplumber",
        "custom/network",
        "tray"
    ],
    "clock": {
        "interval": 10,
        "format": "{:%a • %H:%M • %b-%d}",
        "tooltip-format": "<span font='Source Code Pro 12'>{calendar}</span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#cdd6f4'><b>{}</b></span>",
                "weekdays": "<span color='#89b4fa'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-scroll-up": "shift_up",
            "on-scroll-down": "shift_down"
        }
    },
    "cpu": {
        "format": "cpu [ {usage}% ]",
        "on-click": "alacritty --title top -e top -o %CPU"
    },
    "memory": {
        "format": "mem [ {percentage}% ]",
        "on-click": "alacritty --title top -e top -o %MEM"
    },
    "battery": {
        "format": "bat [ {capacity}% ]",
        "format-charging": "bat [ {capacity}% ⚡ ]",
        "format-plugged": "bat [ {capacity}% 🔌 ]",
        "states": {
            "warning": 30,
            "critical": 15
        },
        "tooltip-format": "Battery: {capacity}%\nTime: {time}\nPower: {power}W"
    },
    "wireplumber": {
        "format": "vol [ {volume}% ]",
        "format-muted": "vol [ muted ]",
        "on-click": "~/.config/waybar/scripts/audio-select.sh",
        "on-click-right": "~/.config/waybar/scripts/audio-input-select.sh"
    },
    "custom/workspaces": {
        "exec": "~/.config/waybar/scripts/mango-workspaces.sh HDMI-A-1",
        "return-type": "json",
        "restart-interval": 3,
        "on-scroll-up": "mmsg dispatch viewtoleft",
        "on-scroll-down": "mmsg dispatch viewtoright"
    },
    "custom/layout": {
        "exec": "~/.config/waybar/scripts/mango-layout.sh HDMI-A-1",
        "return-type": "json",
        "restart-interval": 3
    },
    "tray": {
        "spacing": 4
    },
    "custom/network": {
        "exec": "~/.config/waybar/scripts/network.sh",
        "return-type": "json",
        "interval": 5,
        "on-click-right": "nm-connection-editor"
    },
    "custom/updates": {
        "exec": "~/.config/waybar/scripts/updates.sh",
        "interval": 3600,
        "signal": 8,
        "format": "pkgs [ {} ]",
        "tooltip": true,
        "tooltip-format": "Pending package updates",
        "on-click": "~/.config/waybar/scripts/update-packages.sh",
        "hide-empty-text": true
    },
    "custom/power": {
        "format": "⏻",
        "tooltip": true,
        "tooltip-format": "Power menu",
        "on-click": "~/.config/waybar/scripts/power-menu.sh"
    }
},
{
    "output": "HDMI-A-2",
    "layer": "top",
    "position": "top",
    "height": 16,
    "spacing": 4,
    "margin-top": 0,
